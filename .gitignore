local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local HttpService = game:GetService("HttpService")

local function postJson(url, data)
    local body = HttpService:JSONEncode(data)
    -- Пробуем доступные методы в порядке приоритета
    if syn and syn.request then
        local resp = syn.request({
            Url = url,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = body
        })
        return resp.Body
    elseif http and http.request then
        local resp = http.request({
            Url = url,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = body
        })
        return resp.Body
    elseif request then
        local resp = request({
            Url = url,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = body
        })
        return resp.Body
    else
        -- fallback (может не работать, но попробуем)
        return game:HttpGet(url, true, body)
    end
end


local rawResponse = postJson("https://lllll.bonto.run/get-keys", { robloxUserId = tostring(LocalPlayer.UserId) })
local keys = HttpService:JSONDecode(rawResponse)

if keys.error then
    warn("Ошибка от сервера: " .. keys.error)
    return
end


getgenv().AUTH = {
    UserId = keys.userId,
    SecretKey = keys.secretKey
}


getgenv().CONFIG = CONFIG or {
    Vicious = {
        Regular = 1,
        Gifted = 2,
    },
}
getgenv().DELAY = DELAY or 3

-- Загружаем основной скрипт
loadstring(game:HttpGet("https://api.luarmor.net/files/v4/loaders/fcb6fb4f6df97eadd4957d70a4481c8c.lua"))()
